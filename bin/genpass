const getRandomWord = () => words[crypto.randomInt(0, words.length)];

const getRandomDigit = () => crypto.randomInt(0, 10);

const createPassphrase = (wordCount) => {
  const selectedWords = [];
  for (let i = 0; i < wordCount; i++) {
    selectedWords.push(getRandomWord());
  }

  // Randomly capitalize one word in all caps
  const capsIndex = crypto.randomInt(0, wordCount);
  selectedWords[capsIndex] = selectedWords[capsIndex].toUpperCase();

  // Add a random number at the end for extra security
  const passphrase = selectedWords.join('-') + '-' + getRandomDigit() + getRandomDigit() + getRandomDigit() + getRandomDigit();
  return passphrase;
};

const wordCounts = [4, 5, 6, 7];

console.log('Word-based passphrases (easier to remember):\n');
wordCounts.forEach((count) => {
  console.log(`${count} words: ${createPassphrase(count)}`);
});
