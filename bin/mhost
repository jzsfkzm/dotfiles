#!/Users/joco/.volta/bin/node

const fs = require('fs');
const path = require('path');

class Hoster {
  file = '/etc/hosts';
  usage = 'Usage: mhost [hostname] [(ip)]';

  constructor(args) {
    this.host = null;
    this.ip = undefined;

    try {
      this.checkArgs(args);
      this.host = args[0];
      if (args[1]) {
        this.ip = [args[1]];
      }

      if (this.check(this.host)) {
        this.remove(this.host, this.ip);
        this.remove(`www.${this.host}`, this.ip);
      } else {
        this.add(this.host, this.ip);
        this.add(`www.${this.host}`, this.ip);
      }
    } catch (error) {
      console.error(error.message);
    }
  }

  checkArgs(args) {
    if (args.length < 1) {
      throw new Error(this.usage);
    }
  }

  add(host, ip = ['::1', '127.0.0.1']) {
    if (Array.isArray(ip)) {
      ip.forEach((ipItem) => {
        this.add(host, ipItem);
      });
    } else {
      const line = `${ip.padEnd(16)} ${host.padEnd(32)} # ${host} added by hoster at ${new Date().toISOString()}\n`;
      console.log(`Adding ${line}`);
      fs.appendFileSync(this.file, line);
    }
  }

  remove(host) {
    console.log(`Removing ${host}`);

    const pattern = new RegExp(`# ${host} added by hoster at`);
    const newLines = fs.readFileSync(this.file, 'utf-8')
      .split('\n')
      .filter((line) => {
        return !pattern.test(line);
      })
      .join('\n');

    fs.writeFileSync(this.file, newLines);
  }

  check(host) {
    const lines = fs.readFileSync(this.file, 'utf-8').split('\n');
    const pattern = new RegExp(`# ${host} added by hoster at`);

    for (const line of lines) {
      if (pattern.test(line)) {
        return true;
      }
    }

    return false;
  }
}

const args = process.argv.slice(2);
new Hoster(args);
